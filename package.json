{
  "name": "opencode-ui",
  "version": "0.2.0",
  "description": "OpenCode Desktop Client",
  "homepage": "https://github.com/marmotz/opencode-ui",
  "author": {
    "name": "Marmotz",
    "email": "contact@marmotz.dev"
  },
  "keywords": [
    "opencode",
    "desktop",
    "client",
    "ai",
    "agent"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "run-p postinstall:*",
    "postinstall:electron": "electron-builder install-app-deps",
    "postinstall:fonts": "bun -e \"import {$} from 'bun'; await $`cp ./node_modules/@fontsource-variable/*/files/*-latin-wght-normal.woff2 src/assets/fonts/`; // 1256\"",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "test": "ng test",
    "update:minor": "bunx npm-check-updates -i -t minor",
    "update:latest": "bunx npm-check-updates -i -t latest",
    "bump:patch": "bunx bumpp --release patch package.json main/package.json",
    "bump:minor": "bunx bumpp --release minor package.json main/package.json",
    "bump:major": "bunx bumpp --release major package.json main/package.json"
  },
  "dependencies": {
    "@analogjs/vite-plugin-angular": "2.0.3",
    "@angular-devkit/build-angular": "20.3.9",
    "@angular/cli": "20.3.9",
    "@angular/common": "20.3.10",
    "@angular/compiler": "20.3.10",
    "@angular/compiler-cli": "20.3.10",
    "@angular/core": "20.3.10",
    "@angular/forms": "^20.3.10",
    "@angular/platform-browser": "^20.3.10",
    "@angular/platform-browser-dynamic": "20.3.10",
    "@angular/router": "^20.3.10",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@opencode-ai/sdk": "^1.0.45",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.1.17",
    "diff": "^8.0.2",
    "electron-updater": "^6.6.2",
    "marked": "^17.0.0",
    "ngx-markdown": "^20.1.0",
    "primeng": "^20.3.0",
    "prismjs": "^1.30.0",
    "strip-ansi": "^7.1.2",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/prismjs": "^1.26.5",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "jest": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.1"
  }
}
